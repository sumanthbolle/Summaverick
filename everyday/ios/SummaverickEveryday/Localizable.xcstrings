    "I haven't written this yet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't written this yet."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది ఇంకా రాయలేదు."
          }
        }
      }
    },
    "I listen to the recording itself, so Telugu, Hindi and mixed speech all work. I write the summary, notes and questions in the language above." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I listen to the recording itself, so Telugu, Hindi and mixed speech all work. I write the summary, notes and questions in the language above."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను రికార్డింగ్‌ను నేరుగా వింటాను. అందుకే తెలుగు, హిందీ, కలగలిపిన మాటలు అన్నీ పనిచేస్తాయి. సారాంశం, నోట్స్, ప్రశ్నలు పైన ఎంచుకున్న భాషలో రాస్తాను."
          }
        }
      }
    },
    "I may have heard this wrong. Listen?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I may have heard this wrong. Listen?"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను ఇది తప్పుగా విని ఉండవచ్చు. వింటారా?"
          }
        }
      }
    },
    "I saved the word but couldn't correct this note. Please try again." : {

    },
    "I stop recording after this long without voice, and keep everything said. I'll tell you 30 seconds before, and you can keep recording." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇంత సేపు ఎవరి గొంతూ వినిపించకపోతే రికార్డింగ్ ఆపేస్తాను, అప్పటివరకు చెప్పినదంతా ఉంచుతాను. 30 సెకన్ల ముందే చెబుతాను, మీరు రికార్డింగ్ కొనసాగించవచ్చు."
          }
        }
      }
    },
    "I stopped so the phone can cool down. I'll carry on by myself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stopped so the phone can cool down. I'll carry on by myself."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఫోన్ చల్లబడటానికి ఆపాను. నేనే కొనసాగిస్తాను."
          }
        }
      }
    },
    "I talk to you in this language where I can. Some messages are in English for now." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వీలైనచోట మీతో ఈ భాషలోనే మాట్లాడతాను. ప్రస్తుతానికి కొన్ని సందేశాలు ఇంగ్లీష్‌లో ఉంటాయి."
          }
        }
      }
    },
    "I understand" : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అర్థమైంది"
          }
        }
      }
    },
    "I use these to understand you. Edit or delete anything." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మిమ్మల్ని అర్థం చేసుకోవడానికి నేను వీటిని వాడతాను. ఏదైనా మార్చవచ్చు లేదా తొలగించవచ్చు."
          }
        }
      }
    },
    "I use your name to greet you and to understand your recordings." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మిమ్మల్ని పలకరించడానికి, మీ రికార్డింగ్‌లు అర్థం చేసుకోవడానికి మీ పేరు వాడతాను."
          }
        }
      }
    },
    "I wrote it all down: \"%@\"." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అంతా రాసేశాను: \"%@\"."
          }
        }
      }
    },

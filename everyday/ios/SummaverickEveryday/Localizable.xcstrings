{
  "sourceLanguage" : "en",
  "strings" : {
    " Everyday" : {
      "comment" : "Brand name",
      "shouldTranslate" : false
    },
    "— Made with Summaverick Everyday, on this device." : {
      "comment" : "Last line of the shared notes file",
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— ఈ ఫోన్‌లోనే Summaverick Everydayతో తయారైంది."
          }
        }
      }
    },
    "· %@" : {
      "comment" : "Separator before a value",
      "shouldTranslate" : false
    },
    "\"%@\" is ready when you are." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" మీ కోసం సిద్ధంగా ఉంది."
          }
        }
      }
    },
    "\"%@\" is safe. I'll carry on by myself soon." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" భద్రంగా ఉంది. త్వరలోనే నేనే కొనసాగిస్తాను."
          }
        }
      }
    },
    "\"%@\": %@" : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\": %2$@"
          }
        }
      }
    },
    "\"%@\": notes and quiz questions are ready." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": నోట్స్, ప్రశ్నలు సిద్ధం."
          }
        }
      }
    },
    "\"%@\": read it in a minute." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": ఒక్క నిమిషంలో చదివేయండి."
          }
        }
      }
    },
    "\"%@\": the full notes are on the way." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": పూర్తి నోట్స్ వస్తున్నాయి."
          }
        }
      }
    },
    "\"%@\": writing your notes now." : {
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": ఇప్పుడు నోట్స్ రాస్తున్నాను."
          }
        }
      }
    },
    "\"What did sir say about the exam date?\" I'll answer and take you to that moment in the recording." : {
      "comment" : "Setup tour tip on Ask",
      "localizations" : {
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"పరీక్ష తేదీ గురించి సార్ ఏం చెప్పారు?\" నేను చెప్పి, రికార్డింగ్‌లో ఆ క్షణానికి తీసుకెళ్తాను."
          }
        }
      }
    },

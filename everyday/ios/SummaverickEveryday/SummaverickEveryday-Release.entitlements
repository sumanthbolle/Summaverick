<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Release (TestFlight, App Store). The App Group is shared with the widget extension: the app writes whether a
     recording is going and the record control reads it. Must match SummaverickWidgets-Release.entitlements and both
     distribution profiles. -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.summaverick.everyday</string>
	</array>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Release (TestFlight, App Store). Shared with the app: the record control reads whether a recording is going.
     Must match SummaverickEveryday-Release.entitlements. -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.summaverick.everyday</string>
	</array>
</dict>
</plist>

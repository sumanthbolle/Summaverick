{
  "name": "summaverick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Summaverick — ServiceNow products, AI systems, and the summaverick.com platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply summaverick --local",
    "migrate:remote": "wrangler d1 migrations apply summaverick --remote",
    "seed:quiz:local": "node scripts/seed-quiz.ts --local",
    "seed:quiz:remote": "node scripts/seed-quiz.ts --remote",
    "seed:content:local": "node scripts/seed-content.ts --local",
    "seed:content:remote": "node scripts/seed-content.ts --remote",
    "build:library": "node scripts/build-library.mjs",
    "brand": "node scripts/build-brand-assets.mjs && node scripts/apply-brand.mjs",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "brand:apply": "node scripts/apply-brand.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:ui": "node scripts/verify/homepage.mjs && node scripts/verify/responsive.mjs && node scripts/verify/journeys.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^22.20.2",
    "gsap": "3.12.5",
    "lenis": "1.1.14",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^4.20.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@cloudflare/workerd-linux-64"
    ]
  }
}

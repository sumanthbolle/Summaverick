          }
        }
      }
    },
    "To ask by voice, allow the microphone for Summaverick in Settings. You can still type your question.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ask by voice, allow the microphone for Summaverick in Settings. You can still type your question."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాట్లాడి అడగాలంటే, సెట్టింగ్స్‌లో Summaverickకి మైక్రోఫోన్ అనుమతి ఇవ్వండి. అప్పటివరకు మీ ప్రశ్నను టైప్ చేయవచ్చు."
          }

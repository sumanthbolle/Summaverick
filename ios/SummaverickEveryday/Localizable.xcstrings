          }
        }
      }
    },
    "I couldn't hear anyone speaking in this recording.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రికార్డింగ్‌లో ఎవరి మాటలూ వినిపించలేదు."
          }

      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేసే ముందు కనీసం ఒక సమయం చేర్చండి."
          }
        }
      }
    },
    "All recordings of %@ move into %@. You can't undo this.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ లోని రికార్డింగ్‌లన్నీ %2$@ లోకి వెళ్తాయి. దీన్ని వెనక్కి తీసుకోలేరు."
          }
        }
      }
    },
    "Answers come only from your recordings, with a link to the moment they came from.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers come only from your recordings, with a link to the moment they came from."

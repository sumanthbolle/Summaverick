    "Some details could not be matched to the recording. Save anyway?": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని వివరాలు రికార్డింగ్‌తో సరిపోలలేదు. అయినా సేవ్ చేయాలా?"
          }
        }
      }
    },
    "Some details may not match what was said.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని వివరాలు చెప్పిన మాటలతో సరిపోకపోవచ్చు."
          }
        }
      }
    },
    "Soon you can ask about anything you recorded.": {

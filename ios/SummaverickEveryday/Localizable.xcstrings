          "stringUnit": {
            "state": "translated",
            "value": "To check"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిచూడాల్సినవి"
          }
        }
      },
      "comment": "Today section: memories waiting for the person to check"
    },
    "To do": {

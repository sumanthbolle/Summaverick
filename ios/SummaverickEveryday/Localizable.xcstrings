      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ చేసే ముందు"
          }
        }
      }
    },
    "Breakfast": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టిఫిన్"
          }
        }
      }
    },
    "Browse by": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇలా చూడండి"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దు చేయండి"
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్పు"
          }
        }
      },
      "comment": "Label: what kind of profile change"
    },
    "Change a medicine": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మందు మార్చండి"
          }
        }
      },
      "comment": "Kind of profile change"
    },
    "Change to your profile": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రొఫైల్‌లో మార్పు"
          }
        }
      }
    },
    "Change your routine": {
      "localizations": {

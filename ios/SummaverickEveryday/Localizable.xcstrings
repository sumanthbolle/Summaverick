    },
    "I couldn't answer this. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't answer this. Please try again."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీనికి జవాబు ఇవ్వలేకపోయాను. మళ్ళీ ప్రయత్నించండి."
          }
        }
      }
    },
    "I couldn't catch your question. Please try again, or type it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't catch your question. Please try again, or type it."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రశ్నను రాయలేకపోయాను. మళ్ళీ ప్రయత్నించండి, లేదా టైప్ చేయండి."
          }
        }
      }
    },
    "I couldn't come up with an answer this time.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈసారి జవాబు ఇవ్వలేకపోయాను."
          }
        }
      }
    },
    "I couldn't delete everything. Try again.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్నీ తొలగించలేకపోయాను. మళ్ళీ ప్రయత్నించండి."
          }
        }
      }
    },
    "I couldn't delete this. Please try again.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని తొలగించలేకపోయాను. దయచేసి మళ్ళీ ప్రయత్నించండి."
          }
        }
      }
    },
    "I couldn't finish: %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి చేయలేకపోయాను: %@"
          }
        }
      },
      "comment": "%@ is the reason"
    },
    "I couldn't hear a question. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't hear a question. Please try again."

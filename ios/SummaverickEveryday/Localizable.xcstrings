          "stringUnit": {
            "state": "translated",
            "value": "Summaverick AIని డౌన్‌లోడ్ చేయడానికి సుమారు %lld GB ఖాళీ చేయండి."
          }
        }
      }
    },
    "Getting Summaverick ready… %lld%%": {
      "comment": "Download progress; %lld is percent done",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting Summaverick ready… %lld%%"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Summaverick సిద్ధమవుతోంది… %lld%%"
          }
        }
      }
    },
    "Getting Summaverick ready… %lld%% · about %lld min left": {

        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జవాబులు మీ రికార్డింగ్‌ల నుంచే వస్తాయి. అవి ఎక్కడ విన్నాయో ఆ క్షణానికి లింక్ కూడా ఉంటుంది."
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    " Everyday": {
      "comment": "Brand name",
      "shouldTranslate": false
    },
    "\"%@\" is ready when you are.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" మీ కోసం సిద్ధంగా ఉంది."
          }
        }
      }
    },
    "\"%@\" is safe. I'll carry on by myself soon.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" భద్రంగా ఉంది. త్వరలోనే నేనే కొనసాగిస్తాను."
          }
        }
      }
    },
    "\"%@\": %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\": %2$@"
          }
        }
      }
    },
    "\"%@\": notes and quiz questions are ready.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": నోట్స్, ప్రశ్నలు సిద్ధం."
          }
        }
      }
    },
    "\"%@\": read it in a minute.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": ఒక్క నిమిషంలో చదివేయండి."
          }
        }
      }
    },
    "\"%@\": the full notes are on the way.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": పూర్తి నోట్స్ వస్తున్నాయి."
          }
        }
      }
    },
    "\"%@\": writing your notes now.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": ఇప్పుడు నోట్స్ రాస్తున్నాను."
          }
        }
      }
    },
    "\"What did sir say about the exam date?\" I'll answer and take you to that moment in the recording.": {
      "comment": "Setup tour tip on Ask",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"పరీక్ష తేదీ గురించి సార్ ఏం చెప్పారు?\" నేను చెప్పి, రికార్డింగ్‌లో ఆ క్షణానికి తీసుకెళ్తాను."
          }
        }
      }
    },
    "%@, the short version is here ☕": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, క్లుప్తంగా రెడీ ☕"
          }
        }
      }
    },
    "%lld": {
      "comment": "Badge count",
      "shouldTranslate": false
    },
    "%lld of %lld": {
      "comment": "Setup tour: tip 1 of 4",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld of %lld ready · %@": {
      "comment": "Parts ready, total parts, then what is being written now",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld సిద్ధం · %3$@"
          }
        }
      }
    },
    "%lld of %lld ready. Your notes are done.": {
      "comment": "Parts ready, total parts of a note's notes",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld సిద్ధం. మీ నోట్స్ పూర్తయ్యాయి."
          }
        }
      }
    },
    "%lld of %lld ready: what was said. Writing your notes…": {
      "comment": "Parts ready, total parts of a note's notes",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld సిద్ధం: చెప్పినదంతా రాశాను. ఇప్పుడు నోట్స్ రాస్తున్నాను…"
          }
        }
      }
    },
    "%lld of %lld ready: what was said. Writing your summary…": {
      "comment": "Parts ready, total parts of a note's notes",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld సిద్ధం: చెప్పినదంతా రాశాను. ఇప్పుడు సారాంశం రాస్తున్నాను…"
          }
        }
      }
    },
    "%lld of %lld ready: your summary. Writing your notes…": {
      "comment": "Parts ready, total parts of a note's notes",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld సిద్ధం: మీ సారాంశం. ఇప్పుడు నోట్స్ రాస్తున్నాను…"
          }
        }
      }
    },
    "%lld open to-dos": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld open to-do"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld open to-dos"
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld పని మిగిలి ఉంది"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld పనులు మిగిలి ఉన్నాయి"
                }
              }
            }
          }
        }
      },
      "comment": "Spoken label for the red badge on a topic row"
    },
    "%lld recordings": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld recording"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld recordings"
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld రికార్డింగ్"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld రికార్డింగ్‌లు"
                }
              }
            }
          }
        }
      },
      "comment": "Number of recordings under a topic or person"
    },
    "%lld things need you today": {
      "comment": "Under the greeting; %lld is how many items need the person today",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld thing needs you today"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld things need you today"
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ఈరోజు మీ కోసం %lld పని ఉంది"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ఈరోజు మీ కోసం %lld పనులు ఉన్నాయి"
                }
              }
            }
          }
        }
      }
    },
    "(stopped)": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "(ఆపేశాను)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(stopped)"
          }
        }
      }
    },
    "1 day": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1 రోజు"
          }
        }
      }
    },
    "10 min": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "10 నిమిషాలు"
          }
        }
      }
    },
    "2 min": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "2 నిమిషాలు"
          }
        }
      }
    },
    "30 days": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "30 రోజులు"
          }
        }
      }
    },
    "5 min": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "5 నిమిషాలు"
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "7 రోజులు"
          }
        }
      }
    },
    "A name is needed to save.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేయడానికి మందు పేరు కావాలి."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ యాప్ గురించి"
          }
        }
      }
    },
    "Add a medicine": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మందు చేర్చండి"
          }
        }
      },
      "comment": "Kind of profile change"
    },
    "Add a time": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయం చేర్చండి"
          }
        }
      }
    },
    "Add at least one time before saving.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేసే ముందు కనీసం ఒక సమయం చేర్చండి."
          }
        }
      }
    },
    "Add them here and I'll offer a reminder on Today. Nothing rings until you say Yes.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ చేర్చండి. ఈరోజు పేజీలో రిమైండర్ సూచిస్తాను. మీరు అవును అనే వరకు ఏదీ మోగదు."
          }
        }
      }
    },
    "Add your day and your medicines": {
      "comment": "Today card when setup saved a name but no routine or medicines",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దినచర్య, మందులు జోడించండి"
          }
        }
      }
    },
    "All clear. When I spot something in your recordings, it shows up here.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా క్లియర్. మీ రికార్డింగ్‌లలో నాకు ఏదైనా కనిపిస్తే ఇక్కడ చూపిస్తాను."
          }
        }
      }
    },
    "All done 🎉": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా రెడీ 🎉"
          }
        }
      }
    },
    "All done, %@ 🎉": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా రెడీ, %@ 🎉"
          }
        }
      }
    },
    "All notes and recordings are deleted, and so are your profile, medicines, reminders and everything Summaverick has learned. This cannot be undone.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని నోట్స్, రికార్డింగ్‌లు తొలగిపోతాయి. మీ ప్రొఫైల్, మందులు, రిమైండర్లు, Summaverick నేర్చుకున్నవన్నీ కూడా తొలగిపోతాయి. ఇది తిరిగి తీసుకురాలేము."
          }
        }
      }
    },
    "All recordings of %@ move into %@. You can't undo this.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ లోని రికార్డింగ్‌లన్నీ %2$@ లోకి వెళ్తాయి. దీన్ని వెనక్కి తీసుకోలేరు."
          }
        }
      }
    },
    "All set. I don't need the internet again.": {
      "comment": "Setup download step, when the language pack is already there",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా రెడీ. ఇక ఇంటర్నెట్ అక్కర్లేదు."
          }
        }
      }
    },
    "Allow both": {
      "comment": "Setup: asks for the microphone and notifications, and agrees to the recording line",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండూ అనుమతించు"
          }
        }
      }
    },
    "Allow the microphone for Summaverick in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone for Summaverick in Settings."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్‌లో Summaverickకి మైక్రోఫోన్ అనుమతి ఇవ్వండి."
          }
        }
      }
    },
    "Appearance": {
      "comment": "Settings: the app's look",
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూపం"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అడగండి"
          }
        }
      },
      "comment": "Tab name"
    },
    "Ask Summaverick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Summaverick"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Summaverickని అడగండి"
          }
        }
      }
    },
    "Ask Summaverick…": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Summaverickని అడగండి…"
          }
        }
      }
    },
    "Ask about anything you recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about anything you recorded."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రికార్డ్ చేసిన దేని గురించైనా అడగండి."
          }
        }
      }
    },
    "Ask about this recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about this recording"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రికార్డింగ్ గురించి అడగండి"
          }
        }
      }
    },
    "Ask about your recordings…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about your recordings…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికార్డింగ్‌ల గురించి అడగండి…"
          }
        }
      }
    },
    "Ask by voice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask by voice"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాట్లాడి అడగండి"
          }
        }
      }
    },
    "Audio retention": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆడియో ఎంత కాలం ఉంచాలి"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెనక్కి"
          }
        }
      },
      "comment": "Setup: go to the previous step"
    },
    "Battery's low, so I'll write your notes later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery's low, so I'll write your notes later"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాటరీ తక్కువగా ఉంది, నోట్స్ తర్వాత రాస్తాను"
          }
        }
      }
    },
    "Bed time": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పడుకునే సమయం"
          }
        }
      }
    },
    "Bedtime": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్రపోయే సమయం"
          }
        }
      },

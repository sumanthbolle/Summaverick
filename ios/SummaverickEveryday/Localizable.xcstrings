        }
      }
    },
    "Free up about %lld GB to download Summaverick's AI.": {
      "comment": "%lld is whole gigabytes to free",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up about %lld GB to download Summaverick's AI."
          }
        },

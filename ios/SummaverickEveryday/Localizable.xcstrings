    "Getting ready. One big download and I never need the internet again. %lld%% · about %lld min left": {
      "comment": "Download progress; first %lld is percent done, second is minutes left",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting ready. One big download and I never need the internet again. %lld%% · about %lld min left"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెడీ అవుతున్నాను. ఒక్క పెద్ద డౌన్‌లోడ్ అయితే ఇక ఇంటర్నెట్ అవసరం ఉండదు. %lld%% · సుమారు %lld నిమిషాలు మిగిలాయి"
          }
        }
      }
    },
    "Going slower to keep the phone cool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going slower to keep the phone cool"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్ చల్లగా ఉండేందుకు నెమ్మదిగా రాస్తున్నాను"
          }
        }
      }
    },

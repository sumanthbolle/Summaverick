    },
    "People you talk about appear here after your recordings are processed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you talk about appear here after your recordings are processed."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మాట్లాడే వ్యక్తులు, మీ రికార్డింగ్‌లు ప్రాసెస్ అయిన తర్వాత ఇక్కడ కనిపిస్తారు."

        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "${time}కి ${text} గురించి గుర్తు చేయండి, ${repeats}"
          }
        }
      }
    },
    "Repeat": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్ళీ మళ్ళీ"
          }
        }
      }
    },
    "Saves a reminder in Summaverick, once, every day or every week. It rings at the time you choose.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Summaverickలో ఒకసారి, ప్రతిరోజూ లేదా ప్రతి వారం గుర్తుచేసేదాన్ని సేవ్ చేస్తుంది. మీరు ఎంచుకున్న సమయానికి మోగుతుంది."
          }
        }
      }
    },
    "every %@ at %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి %1$@ %2$@కి"
          }
        }
      }
    },
    "every day at %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతిరోజూ %@కి"
          }
        }
      }
    },
    "%.1f min": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f నిమి"
          }
        }
      }
    },
    "%.1f× faster than the recording": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్ కంటే %.1f× వేగంగా"
          }
        }
      }
    },
    "%lld notes, %@ of recordings": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld నోట్స్, %@ రికార్డింగ్‌లు"
          }
        }
      }
    },
    "%lld s": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld సె"
          }
        }
      }
    },
    "Battery: about %.0f%% per hour recorded": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాటరీ: రికార్డ్ చేసిన ప్రతి గంటకు సుమారు %.0f%%"
          }
        }
      }
    },
    "How it ran on this phone": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోన్‌లో ఎలా నడిచింది"
          }
        }
      }
    },
    "No finished notes measured yet.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా పూర్తయిన నోట్స్ ఏవీ కొలవలేదు."
          }
        }
      }
    },
    "Notes: %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోట్స్: %@"
          }
        }
      }
    },
    "Notes: usually %@ for every 10 minutes recorded": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోట్స్: సాధారణంగా ప్రతి 10 నిమిషాల రికార్డింగ్‌కు %@"
          }
        }
      }
    },
    "Only the time spent working is counted, not pauses. Measured on this phone; nothing is sent anywhere unless you share it.": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పని చేసిన సమయం మాత్రమే లెక్కిస్తాం, విరామాలు కాదు. ఈ ఫోన్‌లోనే కొలుస్తాం; మీరు షేర్ చేస్తేనే ఎక్కడికైనా వెళ్తుంది."
          }
        }
      }
    },
    "Phone: %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్: %@"
          }
        }
      }
    },
    "Rested to cool down: %@": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చల్లబడటానికి విశ్రాంతి: %@"
          }
        }
      }
    },
    "Share speed report": {
      "localizations": {
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేగం నివేదికను షేర్ చేయండి"
          }
        }

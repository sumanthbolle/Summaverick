{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summaverick",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // With "404-page" handling the asset worker claims any navigation request
    // it has no asset for, and answers a POST with 405 before the Worker runs.
    // That broke the contact form for visitors without JavaScript, whose
    // browser posts the form as a navigation.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "summaverick.com", "custom_domain": true },
    { "pattern": "www.summaverick.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "summaverick",
      // Replace after `wrangler d1 create summaverick --location apac`.
      // Any string works for --local; the real UUID is required for --remote.
      "database_id": "e60dc612-a809-418b-b2af-46eb39b5d11f",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    // Binding name must be CONFIG — the Worker reads env.CONFIG everywhere.
    // Replace id after `wrangler kv namespace create CONFIG` (any string works
    // for --local; the real id is only needed for --remote).
    {
      "binding": "CONFIG",
      "id": "648c1f767e62415b93070adc8aafe177"
    }
  ],
  "r2_buckets": [
    { "binding": "BODIES", "bucket_name": "summaverick-content" }
  ],
  "triggers": {
    // 01:00 SGT nightly D1 export -> R2 backups/. 02:00 SGT UPSC retention sweep.
    "crons": ["0 17 * * *", "0 18 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://summaverick.com",
    "MAGIC_LINK_FROM": "login@summaverick.com"
  }
  // Account ID is supplied in CI as CLOUDFLARE_ACCOUNT_ID (do not hard-code a
  // token here). Optional: set "account_id" once you copy it from the dashboard.
}
